{
	"name": "portfolio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "npm run typecheck && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
		"lint": "eslint .",
		"format": "prettier . --write",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage --coverage.thresholds.statements=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100",
		"prepare": "husky"
	},
	"dependencies": {
		"@xterm/addon-fit": "0.11.0",
		"@xterm/addon-web-links": "0.12.0",
		"@xterm/xterm": "6.0.0",
		"pdfjs-dist": "^6.5.438",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.10",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/coverage-v8": "^4.1.12",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.6",
		"prettier": "^3.10.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^4.1.12"
	},
	"lint-staged": {
		"*.{js,cjs,mjs,ts,tsx,css,json,html}": [
			"eslint --fix",
			"prettier --write"
		]
	}
}
